# pbi-orchestration-jev のアーキテクチャ図
# __MONO__ は単色ロゴの色。render.py がライト用 (000000) とダーク用 (ffffff) に置き換えて 2 枚描く
# 生成: python ~/.claude/skills/arch-diagram/versions/v1.1/scripts/render.py assets/architecture.d2
# 2026-10-14 の Template Studio 追加分は d2 v0.7.1 (elk、ライト theme 0 / ダーク theme 200) で描き直した
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  ext: {
    shape: image
    width: 64
    height: 64
    label.near: outside-bottom-center
  }
  zone: {
    style.border-radius: 16
  }
  saas: {
    style: {
      border-radius: 16
      stroke-dash: 3
    }
  }
}

dev: Developer {
  class: ext
  icon: https://icons.terrastruct.com/essentials%2F005-programmer.svg
}

cc: Claude Code {
  class: zone
  icon: https://cdn.simpleicons.org/anthropic/__MONO__

  orch: "Orchestrator\nmain session: PBIs, review, rework" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
  select: "select_model.py\ntier + route" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
  stats: "agent_stats.py\ntokens & cache rebuilds" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
  agent: "4. Agent tool\nhaiku / sonnet / opus" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
  rtk: "rtk-gate.mjs (optional)\ncompresses command output" {
    class: svc
    style.stroke-dash: 3
  }
}

runners: Other runners {
  class: saas
  direction: down

  opencode: "1. opencode CLI\nDeepSeek V4.1 Flash (OpenCode Go)" {
    shape: hexagon
  }
  codex: "2. Codex CLI\ngpt-6-astra (until CODEX_UNTIL)" {
    shape: hexagon
  }
  agy: "3. Antigravity CLI\nClaude Sonnet 5.5" {
    class: svc
    icon: https://cdn.simpleicons.org/google
  }
}

jev: "Jev (TypeSafe)\njudgment API" {
  shape: hexagon
}

studio: Template Studio {
  class: zone

  page: "Studio page (browser)\nopened by /pbi-orchestration-jev templates\npick models, 3 proposals, reorder" {
    class: svc
  }
  serve: "studio/serve.py\n127.0.0.1 + token, POST /apply" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
  catalog: "studio/update_catalog.py\ncatalog.json" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
}

bench: "OpenRouter / Artificial Analysis\nprices, new models, coding index" {
  shape: hexagon
}

repo: Target repository {
  class: zone
  icon: https://cdn.simpleicons.org/git

  code: "Source code\nchanged by runners" {
    class: svc
  }
  pbi: "docs/pbi/\nPBIs, STATUS, reports, HANDOFF, stats" {
    class: svc
    shape: page
  }
  routing: "docs/pbi/routing.json\ntry order, read by select_model.py" {
    class: svc
    shape: page
  }
}

dev <-> cc.orch: task / approval
cc.orch -> cc.select: facts + Jev scores
cc.orch <-> jev: text only: brief, report, rework size
cc.orch -> runners.opencode: PBI path
cc.orch -> runners.codex: "" {style.stroke-dash: 4}
cc.orch -> runners.agy: "" {style.stroke-dash: 4}
cc.orch -> cc.agent: "" {style.stroke-dash: 4}
cc.orch -> cc.rtk: Bash / PowerShell {style.stroke-dash: 4}
runners.opencode -> repo.code
runners.codex -> repo.code
runners.agy -> repo.code
cc.agent -> repo.code
cc.orch -> repo.pbi: status & logs
cc.stats -> repo.pbi: stats {style.stroke-dash: 4}
dev -> studio.page: pick & apply
bench -> studio.catalog: fetch
studio.catalog -> studio.page: models
studio.page -> studio.serve: routing.json
studio.serve -> repo.routing: write
