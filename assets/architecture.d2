# Atelier v8 のアーキテクチャ図
# __MONO__ は単色ロゴの色。render.py がライト用 (000000) とダーク用 (ffffff) に置き換えて 2 枚描く
# 生成: python ~/.claude/skills/arch-diagram/versions/v1.1/scripts/render.py assets/architecture.d2
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  ext: {
    shape: image
    width: 64
    height: 64
    label.near: outside-bottom-center
  }
  zone: {
    style.border-radius: 16
  }
  saas: {
    style: {
      border-radius: 16
      stroke-dash: 3
    }
  }
}

dev: Developer {
  class: ext
  icon: https://icons.terrastruct.com/essentials%2F005-programmer.svg
}

cc: Claude Code {
  class: zone
  icon: https://cdn.simpleicons.org/anthropic/__MONO__

  caller: "Caller (your session)\nloops next → act → done/answer" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
  roles: "Model roles (depth 1)\nsurveyor · interviewer · planner\nworker · reviewer" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
}

conductor: "Conductor (conductor.py, no model)" {
  class: zone
  icon: https://cdn.simpleicons.org/python

  flow: "Run state machine\nnext action, limits, budget, questions" {
    class: svc
  }
  template: "Template\nlevels L1–L5 → routes, roles, limits" {
    class: svc
  }
  guards: "Guard rules G1–G14\nbefore launch, refuse, after-check" {
    class: svc
  }
  record: "Run record\ntokens, rules read and fired" {
    class: svc
  }
}

home: "Your home (~/.config/atelier)" {
  class: zone
  icon: https://icons.terrastruct.com/essentials%2F245-folder.svg

  agents: "agents.json · models/\nrunner registration only" {
    class: svc
    icon: https://icons.terrastruct.com/essentials%2F204-settings.svg
  }
}

runners: "External runners (optional)" {
  class: saas
  direction: down

  codex: "Codex CLI" {
    shape: hexagon
  }
  agy: "Antigravity CLI" {
    class: svc
    icon: https://cdn.simpleicons.org/google
  }
  other: "opencode · dsh · claude -p" {
    shape: hexagon
  }
}

tools: "Skills used when installed" {
  class: saas
  direction: down

  am: "answer-me-with-html\napproval pages" {
    shape: hexagon
  }
  omm: "omm-pr-scan --cache · omm-scan\nOMM map: delta, or a full scan" {
    shape: hexagon
  }
}

outdata: "Outside data\n(real data, samples)" {
  shape: page
}

ommcache: ".omm-cache (outside the repository)" {
  shape: page
}

repo: Target repository {
  class: zone
  icon: https://cdn.simpleicons.org/git

  code: "Source code and rule documents\nrules read by every role" {
    class: svc
  }
  review: "Review skill of the repository\nthe final review" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
  pbi: "docs/pbi/\nrun.json, facts, design tree, PBIs,\nrecord.jsonl, REPORT.md" {
    class: svc
    shape: page
  }
}

dev <-> cc.caller: "task, answers, approvals"
cc.caller <-> conductor.flow: "start · next · done · answer · run"
cc.caller -> cc.roles: "launch with prompt file"
cc.roles -> repo.pbi: "results"
cc.roles -> repo.code: "read rules, build"
cc.caller -> repo.review: "runs once at the end"
outdata -> repo.code: "copied in by the caller after approval" {style.stroke-dash: 4}
conductor.flow -> runners: "run external roles" {style.stroke-dash: 4}
runners -> repo.code {style.stroke-dash: 4}
conductor.flow -> conductor.template
conductor.flow -> conductor.guards
conductor.flow -> conductor.record
conductor.template -> home.agents: "reads runners"
conductor.flow <-> repo.pbi: "state and checks"
conductor.record -> repo.pbi: "record.jsonl, REPORT.md"
conductor.flow -> tools.am: "approval pages" {style.stroke-dash: 4}
cc.roles -> tools.omm: "surveyor" {style.stroke-dash: 4}
cc.caller -> tools.omm: "full scan when asked" {style.stroke-dash: 4}
tools.omm <-> ommcache: "nearest cache, delta"
