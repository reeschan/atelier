# pbi-orchestration-jev のアーキテクチャ図
# __MONO__ は単色ロゴの色。render.py がライト用 (000000) とダーク用 (ffffff) に置き換えて 2 枚描く
# 生成: python ~/.claude/skills/arch-diagram/versions/v1.1/scripts/render.py assets/architecture.d2
# 2026-10-21 に汎用化の段 1 に合わせて描き直した: 既定は全段 pbi-worker、外部の実行先は routing.json で有効にしたときだけ、
# 利用者の home (routing.json・templates・overrides・agents.json・prices.json)、agents.py による手順の照合、Jev は食い違うときの報告と差し戻し文の点検
# 2026-10-21 に段 2 に合わせて描き直した: setup_agents.py が CLI を検出してモデル一覧を home に控え、編集画面 (3 タブ) は home だけに書く。
# 優先テンプレートの正本はローカルの overrides.json で、Web ページは任意の同期先
# 2026-10-21 にフェーズ・アダプターに合わせて描き直した: adapter_gate.py が最終・セキュリティレビューを使うかを決め、
# 包むサブエージェント (general-purpose) が任意の呼び出し先 (mattpocock-skills・built-in のレビュー) を呼ぶ。設計の grilling はメインのセッションから
# 2026-10-23 に jev-mcp を足した: Harness² (MCP クライアント) がタスクを受け取り、モデルの候補 (route)・改善役のセッション (run_session)・記録 (record) を jev-mcp に頼む
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  ext: {
    shape: image
    width: 64
    height: 64
    label.near: outside-bottom-center
  }
  zone: {
    style.border-radius: 16
  }
  saas: {
    style: {
      border-radius: 16
      stroke-dash: 3
    }
  }
}

dev: Developer {
  class: ext
  icon: https://icons.terrastruct.com/essentials%2F005-programmer.svg
}

cc: Claude Code {
  class: zone
  icon: https://cdn.simpleicons.org/anthropic/__MONO__

  orch: "Orchestrator\nmain session: design, PBIs, review, rework, handoff" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
  prepare: "prepare.py → select_model.py + agents.py\nJev gate 1, tier + route, drop unusable steps" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
  verify: "verify.py + unchanged.py\nrun checks, hash untouched files" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
  templates: "templates.py\npriority templates, local overrides.json" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
  worker: "pbi-worker (Agent tool)\ndefault runner for every tier, memory get only" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
  setup: "setup_agents.py + model_fetch.py\ndetect CLIs, fetch each runner's models" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
  gate: "adapter_gate.py\nrun or skip the final and security reviews" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
  final: "Review wrapper (general-purpose)\nFINAL.review / FINAL.security, report only" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
}

callees: "Callee skills (optional, used when installed)" {
  class: saas
  direction: down

  mp: "mattpocock-skills\ngrilling, domain-modeling, code-review" {
    shape: hexagon
  }
  builtin: "Built-in /code-review, /security-review\nship with Claude Code" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
}

home: "Your home (~/.config/pbi-orchestration-jev)" {
  class: zone
  icon: https://icons.terrastruct.com/essentials%2F245-folder.svg

  routing: "routing.json · templates/ · overrides.json\ntry order, priority templates" {
    class: svc
    shape: page
  }
  agents: "agents.json · models/ · prices.json\nrunners, model lists, picks, adapters, prices" {
    class: svc
    icon: https://icons.terrastruct.com/essentials%2F204-settings.svg
  }
}

runners: "External runners (optional, chosen in setup)" {
  class: saas
  direction: down

  opencode: "opencode CLI\ne.g. DeepSeek V4.1 Flash (OpenCode Go)" {
    shape: hexagon
  }
  codex: "Codex CLI" {
    shape: hexagon
  }
  agy: "Antigravity CLI\nClaude Sonnet 5.5" {
    class: svc
    icon: https://cdn.simpleicons.org/google
  }
  dsh: "DeepSeek Harness (dsh)\ne.g. DeepSeek API V4.1 Flash" {
    shape: hexagon
  }
}

jevmcp: "jev-mcp (jev_mcp.py, 127.0.0.1)\ntasks: claim, submit, verify\nmodels: route, run_session, record" {
  class: svc
  icon: https://cdn.simpleicons.org/modelcontextprotocol/__MONO__
}

harness: "Harness² (MCP client, optional)\ntask and model connectors" {
  shape: hexagon
  style.stroke-dash: 3
}

jev: "Jev (TypeSafe)\njudgment API, text only" {
  shape: hexagon
}

memory: "shared-memory MCP (optional)\nrefs per work, handoff memory" {
  class: svc
  icon: https://cdn.simpleicons.org/modelcontextprotocol/__MONO__
  style.stroke-dash: 3
}

web: "Priority templates page (optional)\nclaude.ai Artifact, sync target" {
  class: svc
  icon: https://cdn.simpleicons.org/claude
}

studio: "Editor (studio/serve.py, 127.0.0.1)\ntabs: agents & models, routing,\npriority templates & application" {
  class: svc
  icon: https://icons.terrastruct.com/tech%2Fbrowser-2.svg
}

repo: Target repository {
  class: zone
  icon: https://cdn.simpleicons.org/git

  code: "Source code\nchanged by the runner" {
    class: svc
  }
  pbi: "docs/pbi/\nPBIs, STATUS, HANDOFF, reports, runs" {
    class: svc
    shape: page
  }
  routing: "docs/pbi/routing.json\ntry order for this repository" {
    class: svc
    shape: page
  }
}

dev <-> cc.orch: task / approval / resume
cc.orch -> cc.prepare: facts
cc.prepare -> jev: brief, PBI quality
cc.orch <-> jev: report on mismatch, rework note
cc.orch -> cc.verify: checks
cc.orch -> cc.worker: PBI path
cc.orch -> runners: "" {style.stroke-dash: 4}
cc.worker -> repo.code
runners -> repo.code {style.stroke-dash: 4}
cc.orch -> repo.pbi: status, HANDOFF
cc.orch <-> memory: write refs, handoff {style.stroke-dash: 4}
cc.worker -> memory: get refs {style.stroke-dash: 4}
cc.prepare -> repo.routing: reads
cc.prepare -> home: reads routing, overrides, agents.json
cc.templates <-> home.routing: templates, overrides {style.stroke-dash: 4}
web <-> cc.templates: sync / answer {style.stroke-dash: 4}
dev -> web: apply, extend, stop {style.stroke-dash: 4}
cc.setup -> runners: "--version, list models" {style.stroke-dash: 4}
cc.setup -> home.agents: agents.json, models/
dev -> studio: pick models, build routing, apply
studio <-> home: read / save
cc.orch -> callees.mp: "design: grilling" {style.stroke-dash: 4}
cc.orch -> cc.gate: after all PBIs
cc.gate -> home.agents: adapters
cc.orch -> cc.final: when the gate says run
cc.final -> callees: "code-review, security-review" {style.stroke-dash: 4}
cc.final -> repo.pbi: reviews/final.*.md
harness <-> jevmcp: "claim tasks, route models,\nimprover sessions, record" {style.stroke-dash: 4}
harness -> repo.code: "" {style.stroke-dash: 4}
jevmcp -> repo.pbi: "prompts, reports, runs.jsonl" {style.stroke-dash: 4}
jevmcp -> home: "reads routing, agents.json" {style.stroke-dash: 4}
