# pbi-orchestration-jev のアーキテクチャ図
# __MONO__ は単色ロゴの色。render.py がライト用 (000000) とダーク用 (ffffff) に置き換えて 2 枚描く
# 生成: python ~/.claude/skills/arch-diagram/versions/v1.1/scripts/render.py assets/architecture.d2
# 2026-10-16 に prepare.py / verify.py・pbi-worker・shared-memory・優先テンプレートを足して描き直した (d2 v0.7.1、elk、ライト theme 0 / ダーク theme 200)
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  ext: {
    shape: image
    width: 64
    height: 64
    label.near: outside-bottom-center
  }
  zone: {
    style.border-radius: 16
  }
  saas: {
    style: {
      border-radius: 16
      stroke-dash: 3
    }
  }
}

dev: Developer {
  class: ext
  icon: https://icons.terrastruct.com/essentials%2F005-programmer.svg
}

cc: Claude Code {
  class: zone
  icon: https://cdn.simpleicons.org/anthropic/__MONO__

  orch: "Orchestrator\nmain session: design, PBIs, review, rework, handoff" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
  prepare: "prepare.py → select_model.py\nJev gate 1, tier + route (table only)" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
  verify: "verify.py + unchanged.py\nrun checks, hash untouched files" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
  templates: "templates.py\npriority templates → overrides.json" {
    class: svc
    icon: https://cdn.simpleicons.org/python
  }
  worker: "4. pbi-worker (Agent tool)\nhaiku / sonnet / opus, memory get only" {
    class: svc
    icon: https://cdn.simpleicons.org/claude
  }
  rtk: "rtk-gate.mjs (optional)\ncompresses command output" {
    class: svc
    style.stroke-dash: 3
  }
}

runners: Other runners {
  class: saas
  direction: down

  opencode: "1. opencode CLI\nDeepSeek V4.1 Flash (OpenCode Go)" {
    shape: hexagon
  }
  codex: "2. Codex CLI\ngpt-6-astra (until CODEX_UNTIL)" {
    shape: hexagon
  }
  agy: "3. Antigravity CLI\nClaude Sonnet 5.5" {
    class: svc
    icon: https://cdn.simpleicons.org/google
  }
}

jev: "Jev (TypeSafe)\njudgment API, text only" {
  shape: hexagon
}

memory: "shared-memory MCP (optional)\nrefs per work, handoff memory" {
  class: svc
  icon: https://cdn.simpleicons.org/modelcontextprotocol/__MONO__
  style.stroke-dash: 3
}

web: "Priority templates page\nclaude.ai Artifact with its own DB" {
  class: svc
  icon: https://cdn.simpleicons.org/claude
}

studio: "Template Studio\nstudio/serve.py on 127.0.0.1\npick models, 3 proposals, reorder" {
  class: svc
  icon: https://icons.terrastruct.com/tech%2Fbrowser-2.svg
}

bench: "OpenRouter / Artificial Analysis\nprices, new models, coding index" {
  class: svc
  icon: https://cdn.simpleicons.org/openrouter/__MONO__
}

repo: Target repository {
  class: zone
  icon: https://cdn.simpleicons.org/git

  code: "Source code\nchanged by runners" {
    class: svc
  }
  pbi: "docs/pbi/\nPBIs, STATUS, HANDOFF, reports, logs" {
    class: svc
    shape: page
  }
  routing: "docs/pbi/routing.json\ntry order, read by select_model.py\n(default: routing.default.json)" {
    class: svc
    shape: page
  }
}

dev <-> cc.orch: task / approval / resume
cc.orch -> cc.prepare: facts
cc.prepare -> jev: brief, PBI quality
cc.orch <-> jev: report, rework size
cc.orch -> cc.verify: checks
cc.orch -> runners.opencode: PBI path
cc.orch -> runners.codex: "" {style.stroke-dash: 4}
cc.orch -> runners.agy: "" {style.stroke-dash: 4}
cc.orch -> cc.worker: "" {style.stroke-dash: 4}
cc.orch -> cc.rtk: Bash / PowerShell {style.stroke-dash: 4}
runners.opencode -> repo.code
runners.codex -> repo.code
runners.agy -> repo.code
cc.worker -> repo.code
cc.orch -> repo.pbi: status, HANDOFF
cc.orch <-> memory: write refs, handoff {style.stroke-dash: 4}
cc.worker -> memory: get refs {style.stroke-dash: 4}
cc.templates -> cc.prepare: overrides {style.stroke-dash: 4}
web <-> cc.templates: sync / answer {style.stroke-dash: 4}
dev -> web: apply, extend, stop {style.stroke-dash: 4}
dev -> studio: pick & apply
bench -> studio: models
studio -> repo.routing: write
