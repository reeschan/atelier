{
  "name": "high-model",
  "description": {
    "ja": "強いモデル中心。すべての PBI を agent の opus に回す。実装担当は worker.md のまま。pstack などは component.py add で外部部品として足す (appendix/engine.md)。",
    "en": "High-model centric: every PBI goes to the opus agent. The worker stays worker.md. Add pstack and others as external components with component.py add (appendix/engine.md)."
  },
  "stages": {
    "understand": [
      "understand.builtin"
    ],
    "design": [
      "design.builtin"
    ],
    "plan": [
      "plan.builtin"
    ],
    "route": [
      "route.opus"
    ],
    "build": [
      "build.runners"
    ],
    "verify": [
      "verify.builtin"
    ],
    "review": [
      "review.code-review",
      "review.builtin"
    ],
    "fix": [
      "fix.rework"
    ],
    "finish": [
      "finish.builtin"
    ]
  },
  "gates": [
    {
      "after": "review",
      "components": [
        "gate.security-review"
      ]
    }
  ],
  "optional": [
    {
      "stage": "map",
      "after": "understand",
      "components": [
        "map.builtin"
      ]
    },
    {
      "stage": "lint-survey",
      "after": "understand",
      "components": [
        "lint-survey.jevlint",
        "lint-survey.builtin"
      ]
    },
    {
      "stage": "lint-recheck",
      "after": "verify",
      "components": [
        "lint-recheck.jevlint",
        "lint-recheck.builtin"
      ]
    }
  ],
  "fix": {
    "max_rework": 2
  },
  "build": {
    "external_memory": "none",
    "tests_at_end": {
      "enabled": true,
      "deferred": [],
      "test_paths": [],
      "principle": "principle-test-behavior-not-implementation",
      "implement_tier": "haiku"
    }
  },
  "kiln": {
    "enabled": true,
    "require_skill": false,
    "prompt_install": true,
    "skill": "sac-strategic-compact",
    "skill_url": "https://github.com/reeschan/sac-strategic-compact",
    "designer_soft": 120000,
    "designer_peak": 180000,
    "implementer_soft": 60000,
    "implementer_peak": 90000,
    "handoff_at": 250000,
    "aux_compress_at": 150000,
    "log_path": "docs/pbi/.kiln/compact-events.jsonl"
  },
  "lint": {
    "preset": "full",
    "exclude_questions": [
      "documentation.contracts-stated"
    ],
    "score_drop": 5,
    "function_lines": 100,
    "compliance": 0.7,
    "extensions": [
      ".ts",
      ".tsx",
      ".mts",
      ".cts",
      ".js",
      ".jsx",
      ".mjs",
      ".cjs",
      ".py"
    ],
    "ast_growth": 0.1,
    "report_only_paths": []
  }
}
