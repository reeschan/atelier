{
  "name": "recommended",
  "description": {
    "ja": "作者が実際に使っている構成。jev-routed に、pstack (理解・振り分けのあとの関所・深いレビュー)、mattpocock-skills (設計の grilling と最終レビュー)、yomiyasu (完了報告の推敲) と、オプションの工程のマーケティング (founder-skill の利用者パネル)、UI デザイン (design-studio と ui-video)、状態モデルの検査 (pstack の statechart。使うかを毎回聞く)、セキュリティ (Cloudflare の security-audit。使うかを毎回聞く) を足したもの。interrogate は設計者が自分で動かし、敵役は opus xhigh と sonnet high。スキルはこの例に含まれず、component.py example check が入れ方を出す。",
    "en": "The author's own setup: jev-routed plus pstack (understand, gates after route, deep review), mattpocock-skills (grilling for design, the final review), yomiyasu (polishing the Japanese completion report), the optional stages marketing (founder-skill's user panel), UI design (design-studio and ui-video), model check (pstack's statechart, asked every run) and security (Cloudflare's security-audit, asked every run). interrogate runs in the orchestrator's session, with adversaries on opus xhigh and sonnet high. The skills are not included; component.py example check prints how to install them."
  },
  "skills": [
    {
      "skill": "pstack:how", "stage": "understand",
      "install": {"marketplace_source": "cursor/plugins", "marketplace": "cursor-plugins"},
      "license": "MIT", "link": "https://github.com/cursor/plugins"
    },
    {
      "skill": "mattpocock-skills:grilling", "stage": "design",
      "install": {"marketplace": "claude-plugins-official"},
      "license": "MIT", "link": "https://github.com/mattpocock/skills"
    },
    {
      "skill": "pstack:blast-radius", "stage": "gate", "after": "route",
      "install": {"marketplace_source": "cursor/plugins", "marketplace": "cursor-plugins"},
      "license": "MIT", "link": "https://github.com/cursor/plugins"
    },
    {
      "skill": "pstack:architect", "stage": "gate", "after": "route",
      "forbid": ["do not run Phase D (implementation) or Phase E"],
      "install": {"marketplace_source": "cursor/plugins", "marketplace": "cursor-plugins"},
      "license": "MIT", "link": "https://github.com/cursor/plugins"
    },
    {
      "skill": "mattpocock-skills:code-review", "stage": "review",
      "install": {"marketplace": "claude-plugins-official"},
      "license": "MIT", "link": "https://github.com/mattpocock/skills"
    },
    {
      "skill": "pstack:interrogate", "stage": "review",
      "install": {"marketplace_source": "cursor/plugins", "marketplace": "cursor-plugins"},
      "license": "MIT", "link": "https://github.com/cursor/plugins"
    },
    {
      "skill": "yomiyasu:yomiyasu", "stage": "gate", "after": "finish",
      "install": {"marketplace_source": "nanaism/yomiyasu", "marketplace": "yomiyasu"},
      "license": "MIT", "link": "https://github.com/nanaism/yomiyasu"
    },
    {
      "skill": "pstack:statechart", "stage": "model-check", "after": "design",
      "install": {"marketplace_source": "cursor/plugins", "marketplace": "cursor-plugins"},
      "license": "MIT", "link": "https://github.com/cursor/plugins"
    },
    {
      "skill": "founder-skill:founder-consumer", "stage": "marketing", "after": "understand",
      "install": {"marketplace_source": "Jakeschincariol/founder-skill", "marketplace": "founder-skill"},
      "license": "MIT", "link": "https://github.com/Jakeschincariol/founder-skill"
    },
    {
      "skill": "design-studio", "stage": "ui-design", "after": "design",
      "install": {"command": "git clone https://github.com/reeschan/claude-skill-design-studio.git ~/dev/claude-skill-design-studio && node ~/dev/claude-skill-design-studio/scripts/install-self.ts"},
      "license": "MIT", "link": "https://github.com/reeschan/claude-skill-design-studio"
    },
    {
      "skill": "ui-video", "stage": "ui-design", "after": "design",
      "install": {"command": "git clone https://github.com/reeschan/atelier.git ~/dev/atelier && mkdir -p ~/.claude/skills && cp -r ~/dev/atelier/skills/ui-video ~/.claude/skills/"},
      "license": "MIT", "link": "https://github.com/reeschan/atelier/tree/main/skills/ui-video"
    },
    {
      "skill": "security-audit", "stage": "security", "after": "review",
      "install": {"command": "npx skills add https://github.com/cloudflare/security-audit-skill --skill security-audit --global --agent claude-code --yes"},
      "license": "MIT", "link": "https://github.com/cloudflare/security-audit-skill"
    }
  ],
  "workflow": {
    "name": "recommended",
    "description": {
      "ja": "作者の構成 (examples/workflows/recommended.json から)。jev-routed に pstack・mattpocock-skills・yomiyasu と、オプションの工程 (マーケティング・UI デザイン・状態モデルの検査・セキュリティ) を足したもの。",
      "en": "The author's setup (from examples/workflows/recommended.json): jev-routed plus pstack, mattpocock-skills, yomiyasu and the optional stages (marketing, UI design, model check, security)."
    },
    "stages": {
      "understand": [{"id": "understand.pstack-how", "when": "clearly-complex"}, "understand.builtin"],
      "design": [{"id": "design.mattpocock-skills-grilling", "when": "ask-or-decide"}, "design.builtin"],
      "plan": ["plan.builtin"],
      "route": ["route.jev"],
      "build": ["build.runners"],
      "verify": ["verify.builtin"],
      "review": [
        {"id": "review.pstack-interrogate", "when": "deep", "where": "main", "models": ["opus xhigh", "sonnet high"]},
        {"id": "review.mattpocock-skills-code-review", "when": "adapter-gate"},
        "review.code-review",
        "review.builtin"
      ],
      "fix": ["fix.rework"],
      "finish": ["finish.builtin"]
    },
    "gates": [
      {"after": "plan", "components": ["gate.jev"]},
      {"after": "route", "components": [
        {"id": "gate.pstack-blast-radius", "when": "coupling-high"},
        {"id": "gate.pstack-architect", "when": "tier-opus"}
      ]},
      {"after": "review", "components": ["gate.security-review"]},
      {"after": "finish", "components": ["gate.yomiyasu"]}
    ],
    "optional": [
      {"stage": "marketing", "after": "understand", "components": [
        {"id": "marketing.founder-skill-founder-consumer", "when": "user-facing"}
      ]},
      {"stage": "ui-design", "after": "design", "components": [
        {"id": "ui-design.design-studio", "when": "ui-change"},
        {"id": "ui-design.ui-video", "when": "ui-change"}
      ]},
      {"stage": "model-check", "after": "design", "components": [
        {"id": "model-check.pstack-statechart", "when": "ask-user"}
      ]},
      {"stage": "security", "after": "review", "components": [
        {"id": "security.security-audit", "when": "ask-user"}
      ]}
    ],
    "fix": {"max_rework": 2},
    "build": {"external_memory": "none"}
  }
}
