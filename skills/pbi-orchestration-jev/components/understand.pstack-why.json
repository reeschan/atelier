{
  "id": "understand.pstack-why",
  "stages": [
    "understand"
  ],
  "title": {
    "ja": "pstack の why で今の形の理由を調べる",
    "en": "Find why the code is shaped this way with pstack why"
  },
  "invoke": {
    "kind": "read-skill",
    "plugin": "pstack",
    "path": "skills/why/SKILL.md"
  },
  "doc": "appendix/engine.md",
  "where": "subagent-readonly",
  "memory": "full",
  "when": "clearly-complex",
  "cost": "high",
  "requires": {
    "plugins": [
      "pstack"
    ]
  },
  "forbid": [
    "do not change any file",
    "write the conclusion to docs/pbi/notes/<slug>.why.md and return at most 5 lines and the path"
  ],
  "interactive": false,
  "calls_back": false,
  "license": "MIT",
  "link": "https://github.com/cursor/plugins/tree/main/pstack"
}
