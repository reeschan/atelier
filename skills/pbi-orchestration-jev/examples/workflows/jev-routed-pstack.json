{
  "name": "jev-routed-pstack",
  "description": {
    "ja": "jev-routed に他の人のスキルを足した例。mattpocock-skills の grilling と code-review、明らかに複雑なときの pstack how、opus 段の architect、coupling の高い PBI の blast-radius、deep な作業の interrogate、完了報告の yomiyasu。",
    "en": "Example: jev-routed plus other people's skills: mattpocock-skills grilling and code-review, pstack how for clearly complex work, architect for opus-tier PBIs, blast-radius for high-coupling PBIs, interrogate for deep work, and yomiyasu on the completion report."
  },
  "stages": {
    "understand": [
      "understand.pstack-how",
      "understand.builtin"
    ],
    "design": [
      "design.grilling",
      "design.builtin"
    ],
    "plan": [
      "plan.builtin"
    ],
    "route": [
      "route.jev"
    ],
    "build": [
      "build.runners"
    ],
    "verify": [
      "verify.builtin"
    ],
    "review": [
      "review.pstack-interrogate",
      "review.mattpocock-code-review",
      "review.code-review",
      "review.builtin"
    ],
    "fix": [
      "fix.rework"
    ],
    "finish": [
      "finish.builtin"
    ]
  },
  "gates": [
    {
      "after": "plan",
      "components": [
        "gate.jev"
      ]
    },
    {
      "after": "route",
      "components": [
        "gate.pstack-blast-radius",
        "design.pstack-architect"
      ]
    },
    {
      "after": "review",
      "components": [
        "gate.security-review"
      ]
    },
    {
      "after": "finish",
      "components": [
        "gate.yomiyasu"
      ]
    }
  ],
  "fix": {
    "max_rework": 2
  },
  "build": {
    "external_memory": "none"
  }
}
