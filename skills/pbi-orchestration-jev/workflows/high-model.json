{
  "name": "high-model",
  "description": {
    "ja": "強いモデル中心。すべての PBI を agent の opus に回す。実装担当は worker.md のまま。pstack を足した例は examples/workflows/high-model-pstack.json。",
    "en": "High-model centric: every PBI goes to the opus agent. The worker stays worker.md. With pstack added: examples/workflows/high-model-pstack.json."
  },
  "stages": {
    "understand": [
      "understand.builtin"
    ],
    "design": [
      "design.builtin"
    ],
    "plan": [
      "plan.builtin"
    ],
    "route": [
      "route.opus"
    ],
    "build": [
      "build.runners"
    ],
    "verify": [
      "verify.builtin"
    ],
    "review": [
      "review.code-review",
      "review.builtin"
    ],
    "fix": [
      "fix.rework"
    ],
    "finish": [
      "finish.builtin"
    ]
  },
  "gates": [
    {
      "after": "review",
      "components": [
        "gate.security-review"
      ]
    }
  ],
  "fix": {
    "max_rework": 2
  },
  "build": {
    "external_memory": "none"
  }
}
