---- MODULE CarryOver ----
\* Generated by chart-to-tla.mjs from carry-over-check.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart carry-over.mmd keeps it, checks it, and compares it with the chart.

VARIABLES run, plan, carry, fixTries
vars == <<run, plan, carry, fixTries>>

\* Region Run
runStates == {"Asking about a broken plan", "Asking to rebuild", "Awaiting fix list approval", "Awaiting plan approval", "Building", "Checking", "Fixing", "Reported complete", "Reported unfinished", "Reporting", "Reviewing", "Running E2E"}
\* Region Plan
planStates == {"Plan approved", "Plan not approved"}
\* Region Carry
carryStates == {"Carry-over dropped", "Carry-over open", "No carry-over"}
\* Region FixTries
fixTriesStates == {"Fix PBI 0 times", "Fix PBI 1 time", "Fix PBI 2 times"}

TypeOK ==
    /\ run \in runStates
    /\ plan \in planStates
    /\ carry \in carryStates
    /\ fixTries \in fixTriesStates

Init ==
    /\ run = "Awaiting plan approval"
    /\ plan = "Plan not approved"
    /\ carry = "No carry-over"
    /\ fixTries = "Fix PBI 0 times"

\* 計画を承認した
Step ==
    /\ (run \in {"Awaiting plan approval"} \/ (plan = "Plan not approved" /\ run = "Awaiting plan approval"))
    /\ \/ (run = "Awaiting plan approval" /\ run' = "Building")
       \/ (run \notin {"Awaiting plan approval"} /\ UNCHANGED run)
    /\ \/ (plan = "Plan not approved" /\ run = "Awaiting plan approval" /\ plan' = "Plan approved")
       \/ (~((plan = "Plan not approved" /\ run = "Awaiting plan approval")) /\ UNCHANGED plan)
    /\ UNCHANGED <<carry, fixTries>>

\* waveを作り終えた
Wave ==
    /\ \/ (run = "Building" /\ run' = "Checking")
    /\ UNCHANGED <<plan, carry, fixTries>>

\* 重い修正だと返った
Step2 ==
    /\ \/ (run = "Building" /\ run' = "Asking about a broken plan")
    /\ UNCHANGED <<plan, carry, fixTries>>

\* 組み直すと答えた
Step3 ==
    /\ (run \in {"Asking about a broken plan"} \/ (plan = "Plan approved" /\ run = "Asking about a broken plan") \/ (carry = "Carry-over open" /\ run = "Asking about a broken plan") \/ (fixTries = "Fix PBI 1 time" /\ run = "Asking about a broken plan") \/ (fixTries = "Fix PBI 2 times" /\ run = "Asking about a broken plan"))
    /\ \/ (run = "Asking about a broken plan" /\ run' = "Awaiting plan approval")
       \/ (run \notin {"Asking about a broken plan"} /\ UNCHANGED run)
    /\ \/ (plan = "Plan approved" /\ run = "Asking about a broken plan" /\ plan' = "Plan not approved")
       \/ (~((plan = "Plan approved" /\ run = "Asking about a broken plan")) /\ UNCHANGED plan)
    /\ \/ (carry = "Carry-over open" /\ run = "Asking about a broken plan" /\ carry' = "No carry-over")
       \/ (~((carry = "Carry-over open" /\ run = "Asking about a broken plan")) /\ UNCHANGED carry)
    /\ \/ (fixTries = "Fix PBI 1 time" /\ run = "Asking about a broken plan" /\ fixTries' = "Fix PBI 0 times")
       \/ (fixTries = "Fix PBI 2 times" /\ run = "Asking about a broken plan" /\ fixTries' = "Fix PBI 0 times")
       \/ (~((fixTries = "Fix PBI 1 time" /\ run = "Asking about a broken plan") \/ (fixTries = "Fix PBI 2 times" /\ run = "Asking about a broken plan")) /\ UNCHANGED fixTries)

\* 同じPBIをやり直すと答えた
PBI ==
    /\ \/ (run = "Asking about a broken plan" /\ run' = "Building")
    /\ UNCHANGED <<plan, carry, fixTries>>

\* 通った・残りがある
Step4 ==
    /\ (run \in {"Checking"} \/ (carry = "Carry-over open" /\ run = "Checking") \/ (fixTries = "Fix PBI 1 time" /\ run = "Checking") \/ (fixTries = "Fix PBI 2 times" /\ run = "Checking"))
    /\ \/ (run = "Checking" /\ run' = "Building")
       \/ (run \notin {"Checking"} /\ UNCHANGED run)
    /\ \/ (carry = "Carry-over open" /\ run = "Checking" /\ carry' = "No carry-over")
       \/ (~((carry = "Carry-over open" /\ run = "Checking")) /\ UNCHANGED carry)
    /\ \/ (fixTries = "Fix PBI 1 time" /\ run = "Checking" /\ fixTries' = "Fix PBI 0 times")
       \/ (fixTries = "Fix PBI 2 times" /\ run = "Checking" /\ fixTries' = "Fix PBI 0 times")
       \/ (~((fixTries = "Fix PBI 1 time" /\ run = "Checking") \/ (fixTries = "Fix PBI 2 times" /\ run = "Checking")) /\ UNCHANGED fixTries)
    /\ UNCHANGED <<plan>>

\* 通った・最後のwave
Wave2 ==
    /\ (run \in {"Checking"} \/ (carry = "Carry-over open" /\ run = "Checking") \/ (fixTries = "Fix PBI 1 time" /\ run = "Checking") \/ (fixTries = "Fix PBI 2 times" /\ run = "Checking"))
    /\ \/ (run = "Checking" /\ run' = "Reviewing")
       \/ (run \notin {"Checking"} /\ UNCHANGED run)
    /\ \/ (carry = "Carry-over open" /\ run = "Checking" /\ carry' = "No carry-over")
       \/ (~((carry = "Carry-over open" /\ run = "Checking")) /\ UNCHANGED carry)
    /\ \/ (fixTries = "Fix PBI 1 time" /\ run = "Checking" /\ fixTries' = "Fix PBI 0 times")
       \/ (fixTries = "Fix PBI 2 times" /\ run = "Checking" /\ fixTries' = "Fix PBI 0 times")
       \/ (~((fixTries = "Fix PBI 1 time" /\ run = "Checking") \/ (fixTries = "Fix PBI 2 times" /\ run = "Checking")) /\ UNCHANGED fixTries)
    /\ UNCHANGED <<plan>>

\* 落ちた・残りがある
Step5 ==
    /\ ((run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"}) \/ (carry = "No carry-over" /\ run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"}) \/ (fixTries = "Fix PBI 0 times" /\ run = "Checking") \/ (fixTries = "Fix PBI 1 time" /\ run = "Checking"))
    /\ \/ (run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"} /\ run' = "Building")
       \/ (~((run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"})) /\ UNCHANGED run)
    /\ \/ (carry = "No carry-over" /\ run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"} /\ carry' = "Carry-over open")
       \/ (~((carry = "No carry-over" /\ run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"})) /\ UNCHANGED carry)
    /\ \/ (fixTries = "Fix PBI 0 times" /\ run = "Checking" /\ fixTries' = "Fix PBI 1 time")
       \/ (fixTries = "Fix PBI 1 time" /\ run = "Checking" /\ fixTries' = "Fix PBI 2 times")
       \/ (~((fixTries = "Fix PBI 0 times" /\ run = "Checking") \/ (fixTries = "Fix PBI 1 time" /\ run = "Checking")) /\ UNCHANGED fixTries)
    /\ UNCHANGED <<plan>>

\* 落ちた・最後のwave
Wave3 ==
    /\ ((run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"}) \/ (carry = "No carry-over" /\ run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"}))
    /\ \/ (run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"} /\ run' = "Reviewing")
       \/ (~((run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"})) /\ UNCHANGED run)
    /\ \/ (carry = "No carry-over" /\ run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"} /\ carry' = "Carry-over open")
       \/ (~((carry = "No carry-over" /\ run = "Checking" /\ fixTries \in {"Fix PBI 0 times", "Fix PBI 1 time"})) /\ UNCHANGED carry)
    /\ UNCHANGED <<plan, fixTries>>

\* 上限を超えて落ちた
Step6 ==
    /\ \/ (run = "Checking" /\ fixTries = "Fix PBI 2 times" /\ run' = "Asking to rebuild")
    /\ UNCHANGED <<plan, carry, fixTries>>

\* 作り直すと答えた
Step7 ==
    /\ \/ (run = "Asking to rebuild" /\ run' = "Building")
    /\ UNCHANGED <<plan, carry, fixTries>>

\* 止めると答えた
Step8 ==
    /\ \/ (run = "Asking to rebuild" /\ run' = "Reporting")
    /\ UNCHANGED <<plan, carry, fixTries>>

\* 仕分けた
Step9 ==
    /\ \/ (run = "Reviewing" /\ run' = "Awaiting fix list approval")
    /\ UNCHANGED <<plan, carry, fixTries>>

\* 直す一覧を承認した
Step10 ==
    /\ \/ (run = "Awaiting fix list approval" /\ run' = "Fixing")
    /\ UNCHANGED <<plan, carry, fixTries>>

\* 持ち越しを外して承認した
Step11 ==
    /\ ((run = "Awaiting fix list approval" /\ carry = "Carry-over open") \/ (carry = "Carry-over open" /\ run = "Awaiting fix list approval"))
    /\ \/ (run = "Awaiting fix list approval" /\ carry = "Carry-over open" /\ run' = "Fixing")
       \/ (~((run = "Awaiting fix list approval" /\ carry = "Carry-over open")) /\ UNCHANGED run)
    /\ \/ (carry = "Carry-over open" /\ run = "Awaiting fix list approval" /\ carry' = "Carry-over dropped")
       \/ (~((carry = "Carry-over open" /\ run = "Awaiting fix list approval")) /\ UNCHANGED carry)
    /\ UNCHANGED <<plan, fixTries>>

\* 直すものがない
Step12 ==
    /\ \/ (run = "Awaiting fix list approval" /\ carry \in {"Carry-over dropped", "No carry-over"} /\ run' = "Running E2E")
    /\ UNCHANGED <<plan, carry, fixTries>>

\* 修正が検査を通った
Step13 ==
    /\ (run \in {"Fixing"} \/ (carry = "Carry-over open" /\ run = "Fixing"))
    /\ \/ (run = "Fixing" /\ run' = "Running E2E")
       \/ (run \notin {"Fixing"} /\ UNCHANGED run)
    /\ \/ (carry = "Carry-over open" /\ run = "Fixing" /\ carry' = "No carry-over")
       \/ (~((carry = "Carry-over open" /\ run = "Fixing")) /\ UNCHANGED carry)
    /\ UNCHANGED <<plan, fixTries>>

\* E2Eが通った
E2E ==
    /\ \/ (run = "Running E2E" /\ run' = "Reporting")
    /\ UNCHANGED <<plan, carry, fixTries>>

\* 報告を書いた
Step14 ==
    /\ \/ (run = "Reporting" /\ carry = "No carry-over" /\ run' = "Reported complete")
    /\ UNCHANGED <<plan, carry, fixTries>>

\* 未完了の報告を書いた
Step15 ==
    /\ \/ (run = "Reporting" /\ carry \in {"Carry-over dropped", "Carry-over open"} /\ run' = "Reported unfinished")
    /\ UNCHANGED <<plan, carry, fixTries>>

Next == Step \/ Wave \/ Step2 \/ Step3 \/ PBI \/ Step4 \/ Wave2 \/ Step5 \/ Wave3 \/ Step6 \/ Step7 \/ Step8 \/ Step9 \/ Step10 \/ Step11 \/ Step12 \/ Step13 \/ E2E \/ Step14 \/ Step15

Spec == Init /\ [][Next]_vars

\* ユーザーが承認していない計画で作り始めない
BuildWithoutPlan == ~(run = "Building" /\ plan = "Plan not approved")

\* 持ち越しが残ったまま完了と報告しない
DoneWithCarry == ~(run = "Reported complete" /\ carry = "Carry-over open")

\* 外した持ち越しがあるのに完了と報告しない
DoneWithDropped == ~(run = "Reported complete" /\ carry = "Carry-over dropped")

\* 修正の PBI が上限まで落ちる前に、作り直しの問いで止めない
AskBeforeLimit == ~(run = "Asking to rebuild" /\ fixTries = "Fix PBI 0 times")

\* 修正の PBI が上限まで落ちる前に、作り直しの問いで止めない
AskBeforeLimit2 == ~(run = "Asking to rebuild" /\ fixTries = "Fix PBI 1 time")

====
