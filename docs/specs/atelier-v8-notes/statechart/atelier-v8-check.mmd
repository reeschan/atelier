stateDiagram-v2
    state Whole {
        state Run {
            [*] --> 調べている
            調べている --> 詰めるかを聞いている: 事実の束ができた
            詰めるかを聞いている --> 詰めている: 詰めると答えた
            詰めるかを聞いている --> PBIを書いている: 今の仕様で進めると答えた
            詰めている --> 詰めている: 1巡の答えが返った
            詰めている --> 仕様の承認を待っている: 問いが尽きた
            仕様の承認を待っている --> 詰めている: 仕様を直してと言われた
            仕様の承認を待っている --> PBIを書いている: 仕様を承認した
            PBIを書いている --> 計画の承認を待っている: PBIができた
            計画の承認を待っている --> PBIを書いている: 計画を直してと言われた
            計画の承認を待っている --> 作っている: 計画を承認した
            作っている --> 検査している: 実装役が返った
            検査している --> 自動で直している: 落ちた [まだ自動で直していない]
            %% when まだ自動で直していない
            自動で直している --> 検査している: 直して返った
            検査している --> 作り直しを聞いている: 落ちた [もう自動で直した]
            %% when 自動で1回直した
            作り直しを聞いている --> 作っている: 作り直すと答えた
            作り直しを聞いている --> 作っている: 保留にすると答えた
            検査している --> 作っている: 通った・次のwaveがある
            検査している --> 見直している: 全PBIが通った
            見直している --> 指摘を仕分けている: 見直しが返った
            指摘を仕分けている --> 直す一覧の承認を待っている: 仕分けた
            直す一覧の承認を待っている --> 修正している: 直す一覧を承認した
            直す一覧の承認を待っている --> E2Eを流している: 直すものがない
            修正している --> E2Eを流している: 修正が検査を通った
            E2Eを流している --> 修正している: E2Eで落ちた [上限まで]
            %% when E2Eはまだ落ちていない, E2Eで1回落ちた
            E2Eを流している --> 上限を聞いている: E2Eで落ちた [上限を超えた]
            %% when E2Eで2回落ちた, 上限のあと続けている
            上限を聞いている --> 修正している: 続けると答えた
            上限を聞いている --> 報告している: 止めると答えた
            E2Eを流している --> 報告している: E2Eが通った
        }
        --
        state Plan {
            [*] --> 計画は未承認
            計画は未承認 --> 計画は承認済み: 計画を承認した
        }
        --
        state Spec {
            [*] --> 仕様は未承認
            仕様は未承認 --> 仕様は承認済み: 仕様を承認した
            仕様は未承認 --> 仕様は承認済み: 今の仕様で進めると答えた
        }
        --
        state FixList {
            [*] --> 直す一覧は未承認
            直す一覧は未承認 --> 直す一覧は承認済み: 直す一覧を承認した
        }
        --
        state AutoFix {
            [*] --> まだ自動で直していない
            まだ自動で直していない --> 自動で1回直した: 落ちた [検査の結果]
            %% when 検査している
            自動で1回直した --> 自動で2回直した: 落ちた [検査の結果]
            %% when 検査している
            自動で1回直した --> まだ自動で直していない: 作り直すと答えた
            自動で1回直した --> まだ自動で直していない: 保留にすると答えた
            自動で1回直した --> まだ自動で直していない: 通った・次のwaveがある
        }
        --
        state Review {
            [*] --> まだ見直していない
            まだ見直していない --> 1回見直した: 見直しが返った [見直しの結果]
            %% when 見直している
            1回見直した --> 2回見直した: 見直しが返った [見直しの結果]
            %% when 見直している
        }
        --
        state E2E {
            [*] --> E2Eはまだ落ちていない
            E2Eはまだ落ちていない --> E2Eで1回落ちた: E2Eで落ちた [E2Eの結果]
            %% when E2Eを流している
            E2Eで1回落ちた --> E2Eで2回落ちた: E2Eで落ちた [E2Eの結果]
            %% when E2Eを流している
            E2Eで2回落ちた --> E2Eで3回落ちた: E2Eで落ちた [E2Eの結果]
            %% when E2Eを流している
            E2Eで3回落ちた --> 上限のあと続けている: 続けると答えた
            上限のあと続けている --> E2Eで3回落ちた: E2Eで落ちた [E2Eの結果]
            %% when E2Eを流している
        }
    }
    %% never BuildWithoutPlan: 作っている & 計画は未承認 -- ユーザーが承認していない計画で作り始めない
    %% never PlanWithoutSpec: PBIを書いている & 仕様は未承認 -- 承認していない仕様で PBI を書かない
    %% never TwoAutoFixes: 自動で直している & 自動で2回直した -- 自動で直すのは、ユーザーが決めるまでに 1 回だけ
    %% never SecondReview: 見直している & 1回見直した -- 最後の見直しは 2 回目に入らない
    %% never FixWithoutList: 修正している & 直す一覧は未承認 & E2Eはまだ落ちていない -- 承認していない見直しの指摘を直し始めない
    %% never FixPastLimit: 修正している & E2Eで3回落ちた -- E2E の上限を超えたら、聞かずに修正へ戻らない
