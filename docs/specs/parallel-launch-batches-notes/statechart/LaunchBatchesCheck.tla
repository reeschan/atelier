---- MODULE LaunchBatchesCheck ----
\* Generated by chart-to-tla.mjs from launch-batches-check.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart launch-batches-check.mmd keeps it, checks it, and compares it with the chart.

VARIABLES run, launches, claims, plan
vars == <<run, launches, claims, plan>>

\* Region Run
runStates == {"Asking about a worker's stop", "Asking about guard violations", "Asking about guard violations in fixing", "Awaiting plan approval", "Checking the fixes", "Checking the wave", "Choosing the next launch batch", "Fix launch batch running", "Launch batch running", "Reported", "Reporting", "Reviewing", "Running E2E", "Taking the fix results", "Taking the results"}
\* Region Launches
launchesStates == {"Launches running", "No launch running"}
\* Region Claims
claimsStates == {"No file claimed twice", "Two launches claimed one file"}
\* Region Plan
planStates == {"Plan approved", "Plan not approved"}

TypeOK ==
    /\ run \in runStates
    /\ launches \in launchesStates
    /\ claims \in claimsStates
    /\ plan \in planStates

Init ==
    /\ run = "Awaiting plan approval"
    /\ launches = "No launch running"
    /\ claims = "No file claimed twice"
    /\ plan = "Plan not approved"

\* 計画を承認した
Step ==
    /\ (run \in {"Awaiting plan approval"} \/ (plan = "Plan not approved" /\ run = "Awaiting plan approval"))
    /\ \/ (run = "Awaiting plan approval" /\ run' = "Choosing the next launch batch")
       \/ (run \notin {"Awaiting plan approval"} /\ UNCHANGED run)
    /\ \/ (plan = "Plan not approved" /\ run = "Awaiting plan approval" /\ plan' = "Plan approved")
       \/ (~((plan = "Plan not approved" /\ run = "Awaiting plan approval")) /\ UNCHANGED plan)
    /\ UNCHANGED <<launches, claims>>

\* 一斉起動を始めた
Step2 ==
    /\ (run \in {"Choosing the next launch batch"} \/ (launches = "No launch running" /\ run = "Choosing the next launch batch"))
    /\ \/ (run = "Choosing the next launch batch" /\ run' = "Launch batch running")
       \/ (run \notin {"Choosing the next launch batch"} /\ UNCHANGED run)
    /\ \/ (launches = "No launch running" /\ run = "Choosing the next launch batch" /\ launches' = "Launches running")
       \/ (~((launches = "No launch running" /\ run = "Choosing the next launch batch")) /\ UNCHANGED launches)
    /\ UNCHANGED <<claims, plan>>

\* 全員が終わった
Step3 ==
    /\ (run \in {"Launch batch running"} \/ (launches = "Launches running" /\ run = "Launch batch running"))
    /\ \/ (run = "Launch batch running" /\ run' = "Taking the results")
       \/ (run \notin {"Launch batch running"} /\ UNCHANGED run)
    /\ \/ (launches = "Launches running" /\ run = "Launch batch running" /\ launches' = "No launch running")
       \/ (~((launches = "Launches running" /\ run = "Launch batch running")) /\ UNCHANGED launches)
    /\ UNCHANGED <<claims, plan>>

\* 違反なし・残りがある
Step4 ==
    /\ \/ (run = "Taking the results" /\ claims = "No file claimed twice" /\ run' = "Choosing the next launch batch")
    /\ UNCHANGED <<launches, claims, plan>>

\* 違反なし・waveを作り終えた
Wave ==
    /\ \/ (run = "Taking the results" /\ claims = "No file claimed twice" /\ run' = "Checking the wave")
    /\ UNCHANGED <<launches, claims, plan>>

\* 違反があった
Step5 ==
    /\ \/ (run = "Taking the results" /\ run' = "Asking about guard violations")
    /\ UNCHANGED <<launches, claims, plan>>

\* 止める知らせがあった
Step6 ==
    /\ \/ (run = "Taking the results" /\ claims = "No file claimed twice" /\ run' = "Asking about a worker's stop")
    /\ UNCHANGED <<launches, claims, plan>>

\* もう一度と答えた
Step7 ==
    /\ (run \in {"Asking about guard violations"} \/ (claims = "Two launches claimed one file" /\ run = "Asking about guard violations"))
    /\ \/ (run = "Asking about guard violations" /\ run' = "Choosing the next launch batch")
       \/ (run \notin {"Asking about guard violations"} /\ UNCHANGED run)
    /\ \/ (claims = "Two launches claimed one file" /\ run = "Asking about guard violations" /\ claims' = "No file claimed twice")
       \/ (~((claims = "Two launches claimed one file" /\ run = "Asking about guard violations")) /\ UNCHANGED claims)
    /\ UNCHANGED <<launches, plan>>

\* 止めると答えた
Step8 ==
    /\ (run \in {"Asking about guard violations"} \/ (claims = "Two launches claimed one file" /\ run = "Asking about guard violations"))
    /\ \/ (run = "Asking about guard violations" /\ run' = "Reporting")
       \/ (run \notin {"Asking about guard violations"} /\ UNCHANGED run)
    /\ \/ (claims = "Two launches claimed one file" /\ run = "Asking about guard violations" /\ claims' = "No file claimed twice")
       \/ (~((claims = "Two launches claimed one file" /\ run = "Asking about guard violations")) /\ UNCHANGED claims)
    /\ UNCHANGED <<launches, plan>>

\* 続けると答えた
Step9 ==
    /\ \/ (run = "Asking about a worker's stop" /\ run' = "Choosing the next launch batch")
    /\ UNCHANGED <<launches, claims, plan>>

\* 組み直すと答えた
Step10 ==
    /\ (run \in {"Asking about a worker's stop"} \/ (plan = "Plan approved" /\ run = "Asking about a worker's stop"))
    /\ \/ (run = "Asking about a worker's stop" /\ run' = "Awaiting plan approval")
       \/ (run \notin {"Asking about a worker's stop"} /\ UNCHANGED run)
    /\ \/ (plan = "Plan approved" /\ run = "Asking about a worker's stop" /\ plan' = "Plan not approved")
       \/ (~((plan = "Plan approved" /\ run = "Asking about a worker's stop")) /\ UNCHANGED plan)
    /\ UNCHANGED <<launches, claims>>

\* 作業を止めると答えた
Step11 ==
    /\ \/ (run = "Asking about a worker's stop" /\ run' = "Reporting")
    /\ UNCHANGED <<launches, claims, plan>>

\* 検査が終わった・残りがある
Step12 ==
    /\ \/ (run = "Checking the wave" /\ run' = "Choosing the next launch batch")
    /\ UNCHANGED <<launches, claims, plan>>

\* 検査が終わった・最後のwave
Wave2 ==
    /\ \/ (run = "Checking the wave" /\ run' = "Reviewing")
    /\ UNCHANGED <<launches, claims, plan>>

\* 修正の一斉起動を始めた
Step13 ==
    /\ (run \in {"Reviewing"} \/ (launches = "No launch running" /\ run = "Reviewing"))
    /\ \/ (run = "Reviewing" /\ run' = "Fix launch batch running")
       \/ (run \notin {"Reviewing"} /\ UNCHANGED run)
    /\ \/ (launches = "No launch running" /\ run = "Reviewing" /\ launches' = "Launches running")
       \/ (~((launches = "No launch running" /\ run = "Reviewing")) /\ UNCHANGED launches)
    /\ UNCHANGED <<claims, plan>>

\* 直すものがない
Step14 ==
    /\ \/ (run = "Reviewing" /\ run' = "Running E2E")
    /\ UNCHANGED <<launches, claims, plan>>

\* 修正の全員が終わった
Step15 ==
    /\ (run \in {"Fix launch batch running"} \/ (launches = "Launches running" /\ run = "Fix launch batch running"))
    /\ \/ (run = "Fix launch batch running" /\ run' = "Taking the fix results")
       \/ (run \notin {"Fix launch batch running"} /\ UNCHANGED run)
    /\ \/ (launches = "Launches running" /\ run = "Fix launch batch running" /\ launches' = "No launch running")
       \/ (~((launches = "Launches running" /\ run = "Fix launch batch running")) /\ UNCHANGED launches)
    /\ UNCHANGED <<claims, plan>>

\* 修正に違反なし
Step16 ==
    /\ \/ (run = "Taking the fix results" /\ claims = "No file claimed twice" /\ run' = "Checking the fixes")
    /\ UNCHANGED <<launches, claims, plan>>

\* 修正に違反があった
Step17 ==
    /\ \/ (run = "Taking the fix results" /\ run' = "Asking about guard violations in fixing")
    /\ UNCHANGED <<launches, claims, plan>>

\* 修正をもう一度と答えた
Step18 ==
    /\ (run \in {"Asking about guard violations in fixing"} \/ (launches = "No launch running" /\ run = "Asking about guard violations in fixing") \/ (claims = "Two launches claimed one file" /\ run = "Asking about guard violations in fixing"))
    /\ \/ (run = "Asking about guard violations in fixing" /\ run' = "Fix launch batch running")
       \/ (run \notin {"Asking about guard violations in fixing"} /\ UNCHANGED run)
    /\ \/ (launches = "No launch running" /\ run = "Asking about guard violations in fixing" /\ launches' = "Launches running")
       \/ (~((launches = "No launch running" /\ run = "Asking about guard violations in fixing")) /\ UNCHANGED launches)
    /\ \/ (claims = "Two launches claimed one file" /\ run = "Asking about guard violations in fixing" /\ claims' = "No file claimed twice")
       \/ (~((claims = "Two launches claimed one file" /\ run = "Asking about guard violations in fixing")) /\ UNCHANGED claims)
    /\ UNCHANGED <<plan>>

\* 修正を止めると答えた
Step19 ==
    /\ (run \in {"Asking about guard violations in fixing"} \/ (claims = "Two launches claimed one file" /\ run = "Asking about guard violations in fixing"))
    /\ \/ (run = "Asking about guard violations in fixing" /\ run' = "Reporting")
       \/ (run \notin {"Asking about guard violations in fixing"} /\ UNCHANGED run)
    /\ \/ (claims = "Two launches claimed one file" /\ run = "Asking about guard violations in fixing" /\ claims' = "No file claimed twice")
       \/ (~((claims = "Two launches claimed one file" /\ run = "Asking about guard violations in fixing")) /\ UNCHANGED claims)
    /\ UNCHANGED <<launches, plan>>

\* 修正が検査を通った
Step20 ==
    /\ \/ (run = "Checking the fixes" /\ run' = "Running E2E")
    /\ UNCHANGED <<launches, claims, plan>>

\* 修正をやり直す
Step21 ==
    /\ (run \in {"Checking the fixes"} \/ (launches = "No launch running" /\ run = "Checking the fixes"))
    /\ \/ (run = "Checking the fixes" /\ run' = "Fix launch batch running")
       \/ (run \notin {"Checking the fixes"} /\ UNCHANGED run)
    /\ \/ (launches = "No launch running" /\ run = "Checking the fixes" /\ launches' = "Launches running")
       \/ (~((launches = "No launch running" /\ run = "Checking the fixes")) /\ UNCHANGED launches)
    /\ UNCHANGED <<claims, plan>>

\* E2Eが終わった
E2E ==
    /\ \/ (run = "Running E2E" /\ run' = "Reporting")
    /\ UNCHANGED <<launches, claims, plan>>

\* 報告を書いた
Step22 ==
    /\ \/ (run = "Reporting" /\ run' = "Reported")
    /\ UNCHANGED <<launches, claims, plan>>

\* 2本が同じファイルを申告した
S2 ==
    /\ \/ (claims = "No file claimed twice" /\ launches = "Launches running" /\ claims' = "Two launches claimed one file")
    /\ UNCHANGED <<run, launches, plan>>

Next == Step \/ Step2 \/ Step3 \/ Step4 \/ Wave \/ Step5 \/ Step6 \/ Step7 \/ Step8 \/ Step9 \/ Step10 \/ Step11 \/ Step12 \/ Wave2 \/ Step13 \/ Step14 \/ Step15 \/ Step16 \/ Step17 \/ Step18 \/ Step19 \/ Step20 \/ Step21 \/ E2E \/ Step22 \/ S2

Spec == Init /\ [][Next]_vars

\* 一斉起動の起動がまだ動いているのに、waveの検査を流さない
CheckWhileRunning == ~(run = "Checking the wave" /\ launches = "Launches running")

\* 修正の起動がまだ動いているのに、修正の検査を流さない
FixCheckWhileRunning == ~(run = "Checking the fixes" /\ launches = "Launches running")

\* 起動がまだ動いているのに、守りの違反を聞かない
AskGuardWhileRunning == ~(run = "Asking about guard violations" /\ launches = "Launches running")

\* 修正の起動がまだ動いているのに、守りの違反を聞かない
AskGuardFixWhileRunning == ~(run = "Asking about guard violations in fixing" /\ launches = "Launches running")

\* 起動がまだ動いているのに、作業者の知らせを聞かない
AskStopWhileRunning == ~(run = "Asking about a worker's stop" /\ launches = "Launches running")

\* 2本が同じファイルを申告したまま、次の一斉起動に進まない
NextBatchAfterClash == ~(run = "Choosing the next launch batch" /\ claims = "Two launches claimed one file")

\* 2本が同じファイルを申告したまま、waveの検査に進まない
CheckAfterClash == ~(run = "Checking the wave" /\ claims = "Two launches claimed one file")

\* 2本が同じファイルを申告したまま、修正の検査に進まない
FixCheckAfterClash == ~(run = "Checking the fixes" /\ claims = "Two launches claimed one file")

\* 承認していない計画で一斉起動を始めない
BuildWithoutPlan == ~(run = "Launch batch running" /\ plan = "Plan not approved")

